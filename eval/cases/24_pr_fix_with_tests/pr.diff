--- /dev/null
+++ b/tests/test_pages.py
@@ -0,0 +1,13 @@
+import pytest
+
+from paging.pages import page_count
+
+
+@pytest.mark.parametrize("total, per_page, pages", [(0, 10, 0), (10, 10, 1), (11, 10, 2), (25, 10, 3)])
+def test_page_count_rounds_up(total, per_page, pages):
+    assert page_count(total, per_page) == pages
+
+
+def test_page_count_rejects_zero_per_page():
+    with pytest.raises(ValueError):
+        page_count(5, 0)
